{
  "name": "@solo-compass/web",
  "version": "0.0.1",
  "private": true,
  "description": "Roamorrow — map-first web app",
  "scripts": {
    "dev": "next dev -p 4300",
    "build": "next build",
    "start": "next start -p 4300",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo",
    "e2e": "playwright test",
    "e2e:score": "playwright test e2e/landing-score.spec.ts",
    "e2e:seo": "playwright test e2e/seo-score.spec.ts",
    "security:browser": "playwright test --config playwright.security.config.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "11.12.0",
    "@solo-compass/ai": "workspace:*",
    "@solo-compass/core": "workspace:*",
    "@solo-compass/data": "workspace:*",
    "@solo-compass/routing": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "mapbox-gl": "^3.34.2",
    "next": "16.4.6",
    "posthog-js": "1.447.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vaul": "^1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "10.15.0"
  }
}
