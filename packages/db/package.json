{
  "name": "@solo-compass/db",
  "version": "0.0.1",
  "private": true,
  "description": "Drizzle ORM schema and migrations for Roamorrow",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f ../../docker-compose.yml up -d",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
